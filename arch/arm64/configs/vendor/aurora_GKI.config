CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=m
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_FOD=m
CONFIG_MI_WIRELESS=y
CONFIG_MI_DTPT=y
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m
CONFIG_SET_BW_SETTINGS_MAX=y
CONFIG_MI_ENABLE_DP=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_XLOGCHAR=m
CONFIG_STMVL53L5=m
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
CONFIG_RPMSG_VIRTIO=m
# ISPV4 (Surge external ISP) source is incomplete in this kernel: the module
# references msm_pcie_enable_rc, ispv4_force_prest and ispv4_disable_wakeup,
# none of which are defined here (modpost failure). Disable until ported.
# CONFIG_MIISP is not set
CONFIG_MI_DUMP_DISPLAY=m

CONFIG_MI_HARDWARE_ID=y
CONFIG_TARGET_PRODUCT_AURORA=y

# aurora is pineapple-only; drop sibling SoCs so their device trees don't
# bloat dtbo.img past the 24 MiB partition.
# CONFIG_ARCH_CLIFFS is not set
# CONFIG_ARCH_VOLCANO is not set
